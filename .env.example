# ==============================================================================
# Full-Stack Notes App & Secure Vault - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or configure these variables in your deployment dashboard.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Express API)
# ------------------------------------------------------------------------------
# Port for the Node.js Express server (automatically set on Render / hosting platforms)
PORT=5000

# Application environment ('development' | 'production')
# In 'production', Express enables reverse-proxy trust (app.set('trust proxy', 1))
NODE_ENV=development

# Whitelisted frontend origin for CORS in production (e.g., https://your-app.onrender.com)
# In local development, http://localhost:5173, 5174, 5175 are automatically allowed.
FRONTEND_URL=http://localhost:5175

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite React Client)
# ------------------------------------------------------------------------------
# Base URL for backend API requests (used during 'npm run build' / deployment)
# Fallback default: http://localhost:5000
VITE_API_URL=http://localhost:5000
